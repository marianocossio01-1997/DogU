// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id                        Int               @id @default(autoincrement())
  fullname                  String
  email                     String            @unique
  phone                     String
  image                     String?
  password                  String
  notification_token        String?
  customer_id_mp            String?           @db.VarChar(255)
  create_at                 DateTime          @default(now())
  update_at                 DateTime          @updatedAt
  roles                     UserHasRole[]
  driver_position           DriverPosition?
  client_requests_as_client ClientRequests[]  @relation("client")
  client_requests_as_driver ClientRequests[]  @relation("driver")
  driverTripOffers          DriverTripOffer[] @relation("DriverTripOffers")
  driverCarInfo             DriverCarInfo?
  driverWallet              DriverWallet?
  cards                     UserCard[]
  sent_messages             ChatMessage[]     @relation("sent_messages")
  received_messages         ChatMessage[]     @relation("received_messages")

  @@map("users")
}
model Role {
  id        String        @id
  fullname  String        @unique @db.VarChar(25)
  image     String        @db.VarChar(255)
  route     String        @db.VarChar(255)
  create_at DateTime      @default(now())
  update_at DateTime      @updatedAt
  users     UserHasRole[]

  @@map("roles")
}

model UserHasRole {
  id_user Int
  id_rol  String
  user    User   @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role    Role   @relation(fields: [id_rol], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([id_user, id_rol])
  @@map("users_has_roles")
}

model DriverPosition {
  id_driver Int                  @id
  user      User                 @relation(fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)
  position  Unsupported("POINT")

  @@map("drivers_position")
}

model TimeAndDistanceValues {
  id        Int   @id
  km_value  Float
  min_value Float

  @@map("time_and_distance_values")
}

model CountryConfig {
  id              Int             @id @default(autoincrement())
  country_code    String          @unique @db.VarChar(5)
  country_name    String          @db.VarChar(100)
  currency_code   String          @db.VarChar(5)
  currency_symbol String          @default("$") @db.VarChar(5)
  exchange_rate   Float           @default(1.0)
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  pricing_configs PricingConfig[]

  @@map("country_configs")
}

model PricingConfig {
  id                   Int           @id @default(autoincrement())
  id_country           Int
  base_fare_usd        Float         @default(1.5)
  km_value_usd         Float         @default(0.5)
  min_value_usd        Float         @default(0.1)
  commission_rate      Float         @default(0.20)
  cancellation_fee_usd Float         @default(0.5)
  country              CountryConfig @relation(fields: [id_country], references: [id], onDelete: Cascade, onUpdate: Cascade)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  @@map("pricing_configs")
}

enum PaymentMethod {
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model ClientRequests {
  id                      Int                 @id @default(autoincrement())
  id_client               Int
  id_driver_assigned      Int?
  id_card                 Int?
  client                  User                @relation("client", fields: [id_client], references: [id])
  driver                  User?               @relation("driver", fields: [id_driver_assigned], references: [id])
  card                    UserCard?           @relation(fields: [id_card], references: [id], onDelete: SetNull)
  fare_offered            Float
  fare_assigned           Float?
  platform_fee            Float?
  driver_earnings         Float?
  payment_method          PaymentMethod       @default(CASH)
  payment_status          PaymentStatus       @default(PENDING)
  payment_id              String?             @db.VarChar(255)
  client_rating           Float?
  driver_rating           Float?
  pickup_description     String              @db.VarChar(255)
  destination_description String              @db.VarChar(255)
  pickup_position         Unsupported("POINT")?
  destination_position    Unsupported("POINT")?
  status                  ClientRequestStatus @default(CREATED)
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  driverTripOffers        DriverTripOffer[]
  chat_messages           ChatMessage[]
  wallet_transactions     WalletTransaction[]

  @@map("client_requests")
}

enum ClientRequestStatus {
  CREATED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  TRAVELING
  FINISHED
  CANCELLED
}

model DriverTripOffer {
  id                Int            @id @default(autoincrement())
  id_driver         Int
  id_client_request Int
  fare_offered      Float
  time              Float
  distance          Float
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  driver            User           @relation("DriverTripOffers", fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)
  clientRequest     ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("driver_trip_offers")
}

model DriverCarInfo {
  id_driver  Int      @id
  brand      String   @db.VarChar(50)
  color      String   @db.VarChar(50)
  plate      String   @db.VarChar(50)
  driver     User     @relation(fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("driver_car_info")
}

model DriverWallet {
  id_driver           Int                 @id
  balance             Float               @default(0.0)
  bank_name           String?             @db.VarChar(100)
  cbu_cvu             String?             @db.VarChar(22)
  alias               String?             @db.VarChar(100)
  account_holder_name String?             @db.VarChar(100)
  tax_id              String?             @db.VarChar(20)
  driver              User                @relation(fields: [id_driver], references: [id], onDelete: Cascade, onUpdate: Cascade)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  transactions        WalletTransaction[]
  withdrawals         WithdrawalRequest[]

  @@map("driver_wallets")
}

enum TransactionType {
  TRIP_COMMISSION_DEBIT
  TRIP_EARNING_CREDIT
  CANCELLATION_FEE
  WITHDRAWAL
}

model WalletTransaction {
  id                Int             @id @default(autoincrement())
  id_driver_wallet Int
  id_client_request Int?
  amount            Float
  type              TransactionType
  description       String          @db.VarChar(255)
  created_at        DateTime        @default(now())
  driver_wallet     DriverWallet    @relation(fields: [id_driver_wallet], references: [id_driver], onDelete: Cascade, onUpdate: Cascade)
  client_request    ClientRequests? @relation(fields: [id_client_request], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("wallet_transactions")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model WithdrawalRequest {
  id               Int              @id @default(autoincrement())
  id_driver_wallet Int
  id_card          Int?
  amount           Float
  status           WithdrawalStatus @default(PENDING)
  notes            String?          @db.VarChar(255)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  driver_wallet    DriverWallet     @relation(fields: [id_driver_wallet], references: [id_driver], onDelete: Cascade, onUpdate: Cascade)
  card             UserCard?        @relation(fields: [id_card], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("withdrawal_requests")
}

model UserCard {
  id               Int                 @id @default(autoincrement())
  id_user          Int
  card_holder_name String              @db.VarChar(100)
  last_4           String              @db.VarChar(4)
  brand            String              @db.VarChar(30)
  expiration_month Int
  expiration_year  Int
  card_token       String              @db.VarChar(255)
  is_default       Boolean             @default(false)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  user             User                @relation(fields: [id_user], references: [id], onDelete: Cascade, onUpdate: Cascade)
  withdrawals      WithdrawalRequest[]
  client_requests  ClientRequests[]

  @@map("user_cards")
}

model ChatMessage {
  id                Int            @id @default(autoincrement())
  id_client_request Int
  id_sender         Int
  id_receiver       Int
  message           String         @db.Text
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  client_request    ClientRequests @relation(fields: [id_client_request], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sender            User           @relation("sent_messages", fields: [id_sender], references: [id], onDelete: Cascade, onUpdate: Cascade)
  receiver          User           @relation("received_messages", fields: [id_receiver], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("chat_messages")
}